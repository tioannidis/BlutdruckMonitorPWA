{
  "name": "blood-pressure-tracker",
  "version": "1.0.0",
  "description": "Private PWA zum Blutdruck-Tagebuch mit Mistral-Fotoanalyse",
  "main": "index.html",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "serve": "python -m http.server 8000",
    "start": "python -m http.server 8000"
  },
  "keywords": [
    "pwa",
    "health",
    "blood-pressure",
    "mistral",
    "vanilla-js"
  ],
  "author": "Blutdruck Monitor Team",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "collectCoverageFrom": [
      "js/*.js",
      "!js/ThemeManager.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "babel": {
    "presets": [
      "@babel/preset-env"
    ]
  }
}